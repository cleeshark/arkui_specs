{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "function-context.schema.json",
  "title": "ArkUI Function Evaluation Context",
  "type": "object",
  "required": [
    "func_id",
    "function_path",
    "feature_specs",
    "function_registry_entry",
    "feature_registry_entries",
    "source_revision",
    "tool_version",
    "rule_version"
  ],
  "properties": {
    "func_id": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "function_path": { "type": "string" },
    "design_path": { "type": ["string", "null"] },
    "feature_specs": { "type": "array", "items": { "type": "string" } },
    "function_registry_entry": { "type": "object" },
    "feature_registry_entries": { "type": "array", "items": { "type": "object" } },
    "source_revision": { "type": "string" },
    "tool_version": { "type": "string" },
    "rule_version": { "type": "string" },
    "discovery_notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

