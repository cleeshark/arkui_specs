{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "ArkUI Function Evidence Bundle",
  "type": "object",
  "required": ["func_id", "source_revision", "claims", "metrics"],
  "properties": {
    "func_id": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "source_revision": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "text", "path", "line", "citations", "evidence_status"],
        "properties": {
          "claim_id": { "type": "string" },
          "claim_type": { "type": "string" },
          "text": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "feat_id": { "type": ["string", "null"] },
          "citations": { "type": "array", "items": { "type": "object" } },
          "sdk_declarations": { "type": "array", "items": { "type": "object" } },
          "static_finding_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_status": {
            "type": "string",
            "enum": ["NO_EVIDENCE", "RESOLVED", "PARTIALLY_RESOLVED", "UNRESOLVED"]
          }
        }
      }
    },
    "metrics": { "type": "object" }
  }
}

