{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automated-function-history.schema.json",
  "title": "Automated Function Rolling Report History",
  "type": "object",
  "required": ["schema_version", "mode", "generated_at", "func_id", "reports"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mode": {"type": "string", "const": "archive"},
    "generated_at": {"type": "string", "minLength": 1},
    "func_id": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "reports": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
