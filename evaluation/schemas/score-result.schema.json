{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score-result.schema.json",
  "title": "ArkUI Function Score Result",
  "type": "object",
  "required": [
    "schema_version",
    "rubric_version",
    "complexity_rules_version",
    "aggregator_protocol_version",
    "aggregator_version",
    "func_id",
    "source_revision",
    "dimensions",
    "raw_score",
    "caps",
    "published_score",
    "gate",
    "confidence",
    "execution",
    "admission"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "rubric_version": { "type": "string", "const": "0.1.0" },
    "complexity_rules_version": { "type": "string", "const": "0.1.0" },
    "aggregator_protocol_version": { "type": "string", "const": "0.1.0" },
    "aggregator_version": { "type": "string", "minLength": 1 },
    "func_id": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dimension_score" }
    },
    "raw_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "caps": {
      "type": "object",
      "required": ["active_severities", "applied"],
      "properties": {
        "active_severities": {
          "type": "array",
          "items": { "type": "string", "enum": ["Minor", "Major", "Critical"] },
          "uniqueItems": true
        },
        "applied": {
          "type": "object",
          "required": ["severity", "limit"],
          "properties": {
            "severity": { "type": "string", "enum": ["None", "Minor", "Major", "Critical"] },
            "limit": { "type": "number", "enum": [39, 59, 79, 100] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "published_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "gate": {
      "type": "object",
      "required": ["static", "semantic", "effective"],
      "properties": {
        "static": { "type": "string", "enum": ["pass", "warn", "fail", "error"] },
        "semantic": { "type": "string", "enum": ["pass", "warn", "fail", "error"] },
        "effective": { "type": "string", "enum": ["pass", "warn", "fail", "error"] }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["components", "score", "publishable"],
      "properties": {
        "components": {
          "type": "object",
          "required": [
            "evidence_verification_coverage",
            "human_confirmation",
            "source_revision_reproducibility",
            "tool_execution_completeness"
          ],
          "properties": {
            "evidence_verification_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "human_confirmation": { "type": "number", "minimum": 0, "maximum": 1 },
            "source_revision_reproducibility": { "type": "number", "minimum": 0, "maximum": 1 },
            "tool_execution_completeness": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "publishable": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["static", "evidence", "semantic", "score"],
      "properties": {
        "static": { "type": "boolean" },
        "evidence": { "type": "boolean" },
        "semantic": { "type": "boolean" },
        "score": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "admission": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "type": "string", "enum": ["NOT_READY", "BASELINED", "HIGH_QUALITY"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "criterion_score": {
      "type": "object",
      "required": [
        "criterion_id",
        "conclusion",
        "applicable",
        "max_score",
        "deduction",
        "score"
      ],
      "properties": {
        "criterion_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "conclusion": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "CONTRADICTED",
            "MISSING",
            "NOT_APPLICABLE",
            "NOT_VERIFIABLE"
          ]
        },
        "applicable": { "type": "boolean" },
        "max_score": { "type": "number", "exclusiveMinimum": 0 },
        "deduction": { "type": "number", "minimum": 0 },
        "score": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dimension_score": {
      "type": "object",
      "required": [
        "dimension_id",
        "max_score",
        "applicable_max_score",
        "earned_score",
        "score",
        "verifiability",
        "criteria"
      ],
      "properties": {
        "dimension_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "max_score": { "type": "number", "exclusiveMinimum": 0 },
        "applicable_max_score": { "type": "number", "minimum": 0 },
        "earned_score": { "type": "number", "minimum": 0 },
        "score": { "type": "number", "minimum": 0 },
        "verifiability": { "type": "string", "enum": ["VERIFIABLE", "NOT_VERIFIABLE"] },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion_score" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
