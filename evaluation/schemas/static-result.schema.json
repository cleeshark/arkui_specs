{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static-result.schema.json",
  "title": "ArkUI Function Static Evaluation Result",
  "type": "object",
  "required": ["func_id", "source_revision", "tool_version", "rule_version", "gate", "findings", "metrics"],
  "properties": {
    "func_id": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "source_revision": { "type": "string" },
    "tool_version": { "type": "string" },
    "rule_version": { "type": "string" },
    "gate": { "type": "string", "enum": ["pass", "warn", "fail", "error"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "message", "path"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["Info", "Minor", "Major", "Critical"] },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "func_id": { "type": "string" },
          "feat_id": { "type": "string" },
          "claim_id": { "type": "string" },
          "recommendation": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "metrics": { "type": "object" },
    "traceability": { "type": "object" }
  }
}

