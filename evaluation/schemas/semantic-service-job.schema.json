{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-service-job.schema.json",
  "title": "ArkUI Semantic Evaluation Service Job",
  "description": "Create/snapshot protocol for a local semantic evaluation job. Validated by spec_eval.protocol_validator.JsonSchemaSubsetValidator, so only its supported keyword subset is used.",
  "type": "object",
  "required": [
    "schema_version",
    "func_id",
    "source_revision",
    "run_count",
    "status",
    "progress",
    "executor_config",
    "protocol_version",
    "evaluator_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "job_id": { "type": "string", "minLength": 16 },
    "func_id": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "run_count": { "type": "integer", "minimum": 1, "maximum": 10 },
    "selected_run_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "max_parallel": { "type": "integer", "minimum": 1, "maximum": 8 },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "preparing",
        "evidence",
        "semantic",
        "awaiting_executor",
        "aggregation",
        "archive",
        "site_history",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "progress": { "$ref": "#/$defs/progress" },
    "executor_config": { "$ref": "#/$defs/executor_config" },
    "protocol_version": { "type": "string", "minLength": 1 },
    "evaluator_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "dependency_snapshot": {
      "type": "array",
      "items": { "$ref": "#/$defs/dep_snapshot" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "progress": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "feat_id": { "type": ["string", "null"] },
        "completed_checkpoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_checkpoints": { "type": ["integer", "null"], "minimum": 0 },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "executor_config": {
      "type": "object",
      "required": [
        "type",
        "command",
        "timeout_seconds",
        "max_parallel",
        "output_schema"
      ],
      "properties": {
        "agent_id": { "type": "string", "enum": ["codex", "claude"] },
        "type": { "type": "string", "enum": ["codex-cli", "claude-cli"] },
        "command": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "sandbox": { "type": "string", "enum": ["read-only", "workspace-write", "dangerously-bypass"] },
        "permission_mode": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "max_parallel": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "resolved_params": { "type": "object" },
        "overrides": { "type": "object" },
        "output_schema": { "type": "string", "const": "executor-result.schema.json" }
      },
      "additionalProperties": false
    },
    "dep_snapshot": {
      "type": "object",
      "required": ["repo_name", "branch", "sha", "status"],
      "properties": {
        "repo_name": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["frozen", "stale"] }
      },
      "additionalProperties": false
    }
  }
}
